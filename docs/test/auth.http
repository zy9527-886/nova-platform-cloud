### 1. Login
# POST /auth/login
#
# Request body:
# - username: required. Maps to SysUser.userNm.
# - password: required. Compared as SmUtil.sm3(password) == SysUser.pwd.
#
# Response data:
# - accessToken: Sa-Token JWT token.
# - authUser: AuthUserVo. Also written into JWT extra as authUser.
POST {{baseUrl}}/system/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Aa123456."
}

### 4. Auth resources
# GET /auth/resources
#
# Request headers:
# - Authorization: Bearer {{accessToken}}
#
# Response data:
# - codes: SysMenu[] with typ = 0.
# - menus: AuthMenuVo[] menu tree with typ = 1.
# Backend loads current user resources with one SQL and groups by typ.
GET {{baseUrl}}/system/resources
Authorization: Bearer {{accessToken}}
Content-Type: application/json





### 3. Logout
# POST /auth/logout
#
# Request headers:
# - Authorization: Bearer {{accessToken}}
POST {{baseUrl}}/system/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

