<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.nova.platform.system.dao.SysUserDao">

    <resultMap id="sysUserVoResultMap" type="org.nova.platform.system.entity.vo.SysUserVo">
        <id column="user_id" property="userId"/>
        <result column="user_nm" property="userNm"/>
        <result column="rmk" property="rmk"/>
        <result column="id_typ" property="idTyp"/>
        <result column="id_no" property="idNo"/>
        <result column="real_nm" property="realNm"/>
        <result column="tel" property="tel"/>
        <result column="org_cd" property="orgCd"/>
        <result column="stus" property="stus"/>
        <result column="pwd_err_tms" property="pwdErrTms"/>
        <result column="pwd_chg_tm" property="pwdChgTm"/>
        <result column="lst_lgn_tm" property="lstLgnTm"/>
        <result column="lock_tm" property="lockTm"/>
        <result column="icon" property="icon"/>
        <result column="cre_per" property="crePer"/>
        <result column="cre_tm" property="creTm"/>
        <result column="updt_per" property="updtPer"/>
        <result column="updt_tm" property="updtTm"/>
    </resultMap>

    <select id="selectPage" resultMap="sysUserVoResultMap">
        SELECT u.user_id,
               u.user_nm,
               u.rmk,
               u.id_typ,
               u.id_no,
               u.real_nm,
               u.tel,
               u.org_cd,
               u.stus,
               u.pwd_err_tms,
               u.pwd_chg_tm,
               u.lst_lgn_tm,
               u.lock_tm,
               u.icon,
               u.cre_per,
               u.cre_tm,
               u.updt_per,
               u.updt_tm
        FROM sys_user u
        <where>
            <if test="query != null">
                <if test="query.userNm != null and query.userNm != ''">
                    AND u.user_nm LIKE CONCAT(#{query.userNm}, '%')
                </if>
                <if test="query.idNo != null and query.idNo != ''">
                    AND u.id_no LIKE CONCAT(#{query.idNo}, '%')
                </if>
                <if test="query.realNm != null and query.realNm != ''">
                    AND u.real_nm LIKE CONCAT(#{query.realNm}, '%')
                </if>
                <if test="query.tel != null and query.tel != ''">
                    AND u.tel LIKE CONCAT(#{query.tel}, '%')
                </if>
                <if test="query.stus != null and query.stus != ''">
                    AND u.stus = #{query.stus}
                </if>
                <if test="query.userRolList != null and query.userRolList.size() > 0">
                    AND EXISTS (
                        SELECT 1
                        FROM sys_user_rol ur
                        WHERE ur.user_id = u.user_id
                          AND ur.rol_id IN
                        <foreach collection="query.userRolList" item="userRol" open="(" separator="," close=")">
                            #{userRol.rolId}
                        </foreach>
                    )
                </if>
            </if>
        </where>
        ORDER BY u.cre_tm DESC, u.user_id
    </select>

</mapper>
