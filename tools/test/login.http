### 1. Login
# POST /auth/login
#
# Request body:
# - username: required. Maps to SysUser.userNm.
# - password: required. Compared as SmUtil.sm3(password) == SysUser.pwd.
#
# Response data:
# - accessToken: Sa-Token JWT token.
# - authUser: AuthUserVo. Also written into JWT extra as authUser.
POST {{baseUrl}}/system/login
Content-Type: application/json

{
  "username": "admin",
  "password": "dd9fc35f3dc82b6330e70eaaa7591dac807bc92e6a71f1b992f72e8afe7db4ad"
}

### 4. Auth resources
# GET /auth/resources
#
# Request headers:
# - Authorization: Bearer {{accessToken}}
#
# Response data:
# - codes: SysMenu[] with typ = 0.
# - menus: AuthMenuVo[] menu tree with typ = 1.
# Backend loads current user resources with one SQL and groups by typ.
GET {{baseUrl}}/system/resources
Authorization: Bearer {{accessToken}}
Content-Type: application/json


### 5. Role button path cache
# GET /auth/role-button-paths
#
# Response data:
# - Map<String, List<String>>
# - roleId -> button menu path list.
# - Cached by @Cacheable in Redis. Clear the cache when role-menu/menu changes.
GET {{baseUrl}}/system/roleAndPaths
Authorization: Bearer {{accessToken}}
Content-Type: application/json


### 6. Clear role button path cache
# POST /auth/role-button-paths/clear
#
# Use this after role-menu or button-menu path changes.
POST {{baseUrl}}/system/roleAndPaths/clear
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}


### 7. Logout
# POST /auth/logout
#
# Request headers:
# - Authorization: Bearer {{accessToken}}
POST {{baseUrl}}/system/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}


### 7. roleAndPaths
# GET /auth/roleAndPaths
#
# Request headers:
# - Authorization: Bearer {{accessToken}}
GET {{baseUrl}}/system/roleAndPaths
Content-Type: application/json

{}